# Non-secret Jetson deployment example. Copy selected lines to the local .env file.
# Never commit credentials, tokens, keys, or session values.

# Reproducible image built from docker/Dockerfile.jetson.
PACKAGU_JETSON_IMAGE=packagu/ros2-humble-slam:humble-jetson-p02
PACKAGU_UID=1000
PACKAGU_GID=1000

# Hardware remains disabled until each device is identified and approved.
RPLIDAR_DEVICE=/dev/null
OPENCR_DEVICE=/dev/null
ARM_SERVO_DEVICE=/dev/null
MOTOR_NANO_DEVICE=/dev/null

# floor_reader is opt-in: docker compose --profile camera ... up floor_reader
# C02 must replace disabled with a verified Docker camera backend.
FLOOR_READER_SOURCE=disabled
FLOOR_READER_HOST=127.0.0.1
FLOOR_READER_PORT=8765
PACKAGU_FLOOR_READER=../../../floor_reader
PACKAGU_FLOOR_DATA=../../../floor_reader/data
