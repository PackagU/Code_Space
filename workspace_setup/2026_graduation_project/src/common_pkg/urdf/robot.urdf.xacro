<?xml version="1.0"?>
<robot name="elevator_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== 로봇 기본 파라미터 ===== -->
  <xacro:property name="base_width"  value="0.3"/>   <!-- 본체 폭 [m] -->
  <xacro:property name="base_length" value="0.35"/>  <!-- 본체 길이 [m] -->
  <xacro:property name="base_height" value="0.15"/>  <!-- 본체 높이 [m] -->
  <xacro:property name="base_mass"   value="15.0"/>

  <xacro:property name="wheel_radius"   value="0.035"/> <!-- 바퀴 반지름 7cm/2 -->
  <xacro:property name="wheel_width"    value="0.02"/>
  <xacro:property name="wheel_mass"     value="0.5"/>
  <xacro:property name="wheel_offset_x" value="0.0"/>
  <xacro:property name="wheel_offset_y" value="0.16"/> <!-- base_width/2(0.15) + wheel_width/2(0.01) -->

  <!-- 본체 바닥과 지면 사이 여유 (본체가 바닥에 끌리지 않도록) -->
  <xacro:property name="ground_clearance" value="0.005"/>
  <!-- base_link 의 중심 z (base_footprint 기준): 본체 바닥 = ground_clearance -->
  <xacro:property name="base_z_offset" value="${base_height/2 + ground_clearance}"/>
  <!-- 바퀴 중심을 z=wheel_radius (지면 접촉) 로 두려면 base_link 기준에서 이 값 -->
  <xacro:property name="wheel_z_in_base" value="${wheel_radius - base_z_offset}"/>

  <!-- 캐스터 (볼롤러) -->
  <xacro:property name="caster_radius"   value="${wheel_radius}"/>
  <xacro:property name="caster_offset_x" value="0.13"/>
  <xacro:property name="caster_mass"     value="0.1"/>

  <!-- ===== 관성 매크로 ===== -->
  <!-- 직육면체 -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(1.0/12.0)*m*(y*y + z*z)}" ixy="0" ixz="0"
        iyy="${(1.0/12.0)*m*(x*x + z*z)}" iyz="0"
        izz="${(1.0/12.0)*m*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- 원통 (회전 대칭축은 link 의 z 축) -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(1.0/12.0)*m*(3*r*r + h*h)}" ixy="0" ixz="0"
        iyy="${(1.0/12.0)*m*(3*r*r + h*h)}" iyz="0"
        izz="${(1.0/2.0)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- 구 -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(2.0/5.0)*m*r*r}" ixy="0" ixz="0"
        iyy="${(2.0/5.0)*m*r*r}" iyz="0"
        izz="${(2.0/5.0)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ===== 베이스 ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ===== 왼쪽 바퀴 ===== -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_z_in_base}" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <!-- ===== 오른쪽 바퀴 ===== -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_offset_x} ${-wheel_offset_y} ${wheel_z_in_base}" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <!-- ===== 캐스터 (볼롤러 2개: 앞/뒤) ===== -->
  <xacro:macro name="caster_ball" params="name x">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 ${wheel_z_in_base}" rpy="0 0 0"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>
  </xacro:macro>

  <xacro:caster_ball name="caster_front" x="${caster_offset_x}"/>
  <xacro:caster_ball name="caster_back"  x="${-caster_offset_x}"/>

  <!-- ===== LiDAR 마운트 ===== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 ${base_height/2 + 0.05}" rpy="0 0 0"/>
  </joint>

  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.04" h="0.05"/>
  </link>

  <!-- ===== Gazebo material/friction ===== -->

  <!-- 바퀴 마찰 (없으면 헛바퀴) -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 캐스터(볼롤러): 마찰 0 으로 자유롭게 미끄러짐 -->
  <gazebo reference="caster_front_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_back_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 본체 -->
  <gazebo reference="base_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="laser">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ===== Gazebo 플러그인 ===== -->

  <!-- 차동 구동 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_offset_y * 2}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 조인트 상태 publish (RViz 에서 바퀴 회전 보이게) -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- LiDAR 센서 (RPLiDAR A1 근사: 360도, 8m) -->
  <gazebo reference="laser">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
