# =====================================================
# Notion docs sync — required vars
# =====================================================
# 1. Create a Notion internal integration:
#    https://www.notion.so/profile/integrations  →  "New integration"
#    - Name: docs-sync (or anything)
#    - Type: Internal
#    - Capabilities: Read/Update/Insert content
#
# 2. Copy the "Internal Integration Secret" below.
#
# 3. In Notion, open the parent page where the wiki should live
#    (e.g. 종설_6조 root page), click "..." → "Connections" →
#    add your "docs-sync" integration. Child pages inherit access.
#
# 4. Get the page ID from the page URL:
#    https://www.notion.so/Workspace/<title>-<32-char-id>
#    Use the 32-char id (hyphens optional).
#
# 5. Copy this file to .env (which is git-ignored) and fill in values:
#       cp .env.example .env
#
# Reminder: AGENTS.md rule #7 — never commit or upload the real .env.
# =====================================================

# Notion API token (starts with "secret_" or "ntn_")
NOTION_TOKEN=secret_PLACEHOLDER_REPLACE_ME

# Page ID under which "📚 문서 위키" will be created (the 종설_6조 root page)
# From AGENTS.md: 2e19c69b-0345-807c-9bdd-cfc401a76017
NOTION_PARENT_PAGE_ID=2e19c69b0345807c9bddcfc401a76017
